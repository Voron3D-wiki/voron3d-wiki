---
/**
 * Where-to-buy options for a product.
 *
 * Replaces the run-on `**Buy**: [Amazon ](…) [Biqu Offical Store](…)` pattern,
 * which had six different shapes across the wiki — inline space-separated,
 * comma-separated, indented sublists, a bare link on the next line, headings
 * called "Purchase Options" / "Purchase Links:" / "Purchase Information", a
 * stray trailing `|`, and hand-written `← *Affiliate link*` notes.
 *
 * Each option renders as its own target rather than a run of links sharing a
 * line, which matters most on mobile where adjacent inline links are hard to
 * hit accurately.
 *
 * Vendor names come from the URL (src/lib/link-kind.mjs), so "Amazon",
 * "amazon", "Amazon ", "West3d" and "Biqu Offical Store" all become one
 * consistent name. Affiliate-network redirectors (tidd.ly, awin1, collabs.shop)
 * cannot be identified from the hostname, so those take an explicit `label`.
 *
 * ON THE DISCLOSURE
 *
 * This used to print the full "Tagged links are affiliate links — buying
 * through them supports the wiki at no extra cost to you" sentence inside every
 * block. Product pages carry three or four blocks plus <AffiliateDisclosure> at
 * the foot, so the same sentence appeared four times on one page, which is
 * where it stops reading as a disclosure and starts reading as noise.
 *
 * The obligation is met at three levels instead, without repetition:
 *   - per link: the tag glyph and rel="sponsored";
 *   - per block: the word "affiliate" in the heading row;
 *   - per page: <AffiliateDisclosure>, which states the arrangement in full.
 *
 * Usage:
 *   <BuyOptions options={[
 *     { href: 'https://amzn.to/…' },
 *     { href: 'https://tidd.ly/…', label: 'BIQU' },
 *     { href: 'https://west3d.com/…', note: '350mm kit' },
 *   ]} />
 */
import { classify, hostOf, relFor, vendorName } from '~/lib/link-kind.mjs';

interface BuyOption {
  href: string;
  /** Needed only for affiliate-network redirectors, where the URL hides the shop. */
  label?: string;
  /** Optional qualifier, e.g. a variant or size. */
  note?: string;
}

interface Props {
  options: BuyOption[];
  /** Overrides the "Where to buy" heading. */
  title?: string;
}

const { options, title = 'Where to buy' } = Astro.props;

const resolved = options
  .map((option) => {
    const host = hostOf(option.href);
    if (!host) return null;
    const kind = classify(host);
    return {
      ...option,
      kind,
      name: option.label ?? vendorName(option.href) ?? host,
      isAffiliate: kind === 'affiliate',
    };
  })
  .filter(Boolean) as Array<BuyOption & { kind: string; name: string; isAffiliate: boolean }>;

const anyAffiliate = resolved.some((o) => o.isAffiliate);
---

{
  resolved.length > 0 && (
    <div class="buy">
      <p class="buy__title">
        {title}
        {anyAffiliate && (
          <>
            <span class="buy__sep" aria-hidden="true">·</span>
            <a class="buy__note-link" href="/policies/">
              <svg viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" focusable="false" fill="currentColor">
                <path d="M21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9a2 2 0 0 0 2.82 0l7-7a2 2 0 0 0 0-2.84zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z" />
              </svg>
              affiliate links
            </a>
          </>
        )}
      </p>

      <ul class="buy__list">
        {resolved.map((option) => (
          <li>
            <a
              class:list={['buy__option', option.isAffiliate && 'buy__option--affiliate']}
              href={option.href}
              target="_blank"
              rel={relFor(option.kind)}
            >
              <span class="buy__vendor">{option.name}</span>
              {option.note && <span class="buy__note">{option.note}</span>}
              {option.isAffiliate && (
                <>
                  <svg class="buy__tag" viewBox="0 0 24 24" width="11" height="11" aria-hidden="true" focusable="false" fill="currentColor">
                    <path d="M21.41 11.58l-9-9A2 2 0 0 0 11 2H4a2 2 0 0 0-2 2v7a2 2 0 0 0 .59 1.42l9 9a2 2 0 0 0 2.82 0l7-7a2 2 0 0 0 0-2.84zM6.5 8A1.5 1.5 0 1 1 8 6.5 1.5 1.5 0 0 1 6.5 8z" />
                  </svg>
                  <span class="sr-only"> (affiliate link — we may earn a commission)</span>
                </>
              )}
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  /* No panel, no fill. The label row and the option buttons are enough to read
     this as a group; wrapping it in a tinted box as well was one of the boxes
     that made product pages feel like a stack of cards. */
  .buy {
    margin-block: var(--space-5);
  }

  .buy__title {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0 0 var(--space-3);
    color: var(--fg-faint);
    font-size: var(--text-xs);
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .buy__sep {
    color: var(--rule-strong);
  }

  .buy__note-link {
    display: inline-flex;
    align-items: center;
    gap: 0.25em;
    color: var(--fg-faint);
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .buy__note-link svg {
    color: var(--accent);
  }

  .buy__note-link:hover {
    color: var(--fg-muted);
    text-decoration: underline;
  }

  .buy__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .buy__list li {
    margin: 0;
  }

  .buy__option {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* A real target rather than a word in a run of links — inline links sitting
       next to each other are the hardest thing to tap accurately on a phone. */
    min-height: 2.25rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    color: var(--fg);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--ease), color var(--ease);
  }

  .buy__option:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .buy__option--affiliate .buy__tag {
    flex: none;
    color: var(--accent);
  }

  .buy__note {
    font-weight: 400;
    font-size: var(--text-xs);
    color: var(--fg-faint);
  }

  /* Full-width stacked options on narrow screens — easier to hit, and the
     vendor names stay left-aligned and scannable. */
  @media (max-width: 30rem) {
    .buy__list {
      flex-direction: column;
      align-items: stretch;
    }
    .buy__option {
      justify-content: flex-start;
    }
  }
</style>
