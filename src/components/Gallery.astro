---
/**
 * Image gallery with click-to-zoom.
 *
 * The MkDocs site used the glightbox plugin so build photos could be opened
 * full size. That plugin has no Starlight equivalent and was silently lost in
 * the migration, leaving galleries as a bullet list of full-width images.
 *
 * This restores it: a responsive thumbnail grid plus a native <dialog>
 * lightbox. No dependency, and <dialog> brings focus trapping and Escape-to-
 * close for free rather than needing them reimplemented.
 *
 * Usage:
 *   <Gallery images={[
 *     { src: img1, alt: 'Board, top view' },
 *   ]} />
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface GalleryImage {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  images: GalleryImage[];
  columns?: number;
}

const { images, columns = 3 } = Astro.props;
---

<div class="gallery" style={`--gallery-columns:${columns}`}>
  {
    images.map((image, i) => (
      <button class="gallery__item" data-gallery-index={i} aria-label={`Open image: ${image.alt}`}>
        <Image src={image.src} alt={image.alt} widths={[320, 640]} sizes="(max-width: 40rem) 45vw, 20rem" loading="lazy" />
      </button>
    ))
  }
</div>

<dialog class="gallery__lightbox" aria-label="Image viewer">
  <button class="gallery__close" aria-label="Close image viewer">&times;</button>
  <button class="gallery__nav gallery__nav--prev" aria-label="Previous image">&#8249;</button>
  <img class="gallery__full" src="" alt="" />
  <button class="gallery__nav gallery__nav--next" aria-label="Next image">&#8250;</button>
  <p class="gallery__caption" />
</dialog>

<script>
  // Scoped per gallery so several can coexist on one page.
  document.querySelectorAll<HTMLElement>('.gallery').forEach((gallery) => {
    const dialog = gallery.nextElementSibling as HTMLDialogElement | null;
    if (!dialog) return;

    const full = dialog.querySelector('.gallery__full') as HTMLImageElement;
    const caption = dialog.querySelector('.gallery__caption') as HTMLElement;
    const items = [...gallery.querySelectorAll<HTMLButtonElement>('.gallery__item')];
    const sources = items.map((item) => {
      const img = item.querySelector('img') as HTMLImageElement;
      return { src: img.currentSrc || img.src, alt: img.alt };
    });

    let current = 0;

    function show(index: number) {
      current = (index + sources.length) % sources.length;
      full.src = sources[current].src;
      full.alt = sources[current].alt;
      caption.textContent = sources[current].alt;
    }

    items.forEach((item, i) =>
      item.addEventListener('click', () => {
        show(i);
        dialog.showModal();
      })
    );

    dialog.querySelector('.gallery__close')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('.gallery__nav--prev')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('.gallery__nav--next')?.addEventListener('click', () => show(current + 1));

    // Click the backdrop (but not the image) to dismiss.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  });
</script>

<style>
  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
    gap: 0.75rem;
    margin-block: 1.5rem;
  }

  .gallery__item {
    padding: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    overflow: hidden;
    background: none;
    cursor: zoom-in;
    line-height: 0;
    transition: border-color 140ms ease, scale 140ms ease;
  }

  .gallery__item:hover,
  .gallery__item:focus-visible {
    border-color: var(--sl-color-accent);
    scale: 1.015;
  }

  .gallery__item :global(img) {
    width: 100%;
    height: 11rem;
    object-fit: cover;
  }

  .gallery__lightbox {
    width: min(94vw, 70rem);
    max-width: 94vw;
    max-height: 92vh;
    padding: 0;
    border: none;
    border-radius: 0.6rem;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    overflow: visible;
  }

  .gallery__lightbox::backdrop {
    background: rgb(0 0 0 / 0.82);
  }

  .gallery__full {
    display: block;
    width: 100%;
    max-height: 82vh;
    object-fit: contain;
  }

  .gallery__caption {
    margin: 0;
    padding: 0.6rem 0.9rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    text-align: center;
  }

  .gallery__close,
  .gallery__nav {
    position: absolute;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 50%;
    background: var(--sl-color-black);
    color: var(--sl-color-white);
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  .gallery__close:hover,
  .gallery__nav:hover {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
  }

  .gallery__close {
    top: -1.1rem;
    inset-inline-end: -1.1rem;
  }

  .gallery__nav {
    top: 50%;
    translate: 0 -50%;
  }

  .gallery__nav--prev {
    inset-inline-start: -1.1rem;
  }

  .gallery__nav--next {
    inset-inline-end: -1.1rem;
  }

  @media (max-width: 45rem) {
    .gallery__close { top: 0.4rem; inset-inline-end: 0.4rem; }
    .gallery__nav--prev { inset-inline-start: 0.4rem; }
    .gallery__nav--next { inset-inline-end: 0.4rem; }
  }
</style>
