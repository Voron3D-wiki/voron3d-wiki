---
/**
 * Product summary: image, spec table, and buy links.
 *
 * This is the layout that was being hand-built in markdown with nested divs,
 * inline `style={{order: "1"}}`, and a <table> per product — about 35 lines of
 * markup each, repeated down printers/index.mdx, all slightly different.
 *
 * As a component it is declarative, responsive without media-query juggling,
 * and — the part that matters editorially — the buy links render in a fixed
 * position at the bottom. An author cannot accidentally lead with them, so the
 * "explanation before recommendation" rule is enforced by the layout rather
 * than by everyone remembering it.
 *
 * Buy links are marked automatically by the affiliate badge system, same as
 * links in prose.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BuyOptions from './BuyOptions.astro';

interface BuyLink {
  href: string;
  /** Optional override; the vendor name is derived from the URL otherwise. */
  label?: string;
  note?: string;
}

interface Props {
  title: string;
  href?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  specs: [string, string][];
  buy?: BuyLink[];
  /** Put the image on the right instead of the left. */
  flip?: boolean;
}

const { title, href, image, imageAlt, specs, buy = [], flip = false } = Astro.props;
---

<section class="product-wrap">
<div class:list={['product', flip && 'product--flip']}>
  {
    image && (
      <div class="product__media">
        <Image src={image} alt={imageAlt ?? title} widths={[320, 640]} sizes="(max-width: 50rem) 90vw, 22rem" />
      </div>
    )
  }

  <div class="product__detail">
    <h3 class="product__title">{href ? <a href={href}>{title}</a> : title}</h3>

    <dl class="product__specs">
      {
        specs.map(([label, value]) => (
          <div class="product__spec">
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))
      }
    </dl>

    <slot />

    {/* Delegated so a product's buy block looks identical to one written
        inline on any other page — same panel, same vendor naming, same single
        group disclosure. */}
    {buy.length > 0 && <BuyOptions options={buy} />}

    {href && <a class="product__more" href={href}>Full guide</a>}
  </div>
</div>
</section>

<style>
  /* The content column here is ~640px wide even on a 1280px viewport, so a
     viewport media query is the wrong tool — it measures the window, not the
     space this actually has. A container query measures the real width. */
  .product-wrap {
    container-type: inline-size;
  }

  .product {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
    margin-block: 2rem;
    padding-block-end: 2rem;
    border-block-end: 1px solid var(--sl-color-gray-6);
  }

  .product--flip {
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
  }

  .product--flip .product__media {
    order: 2;
  }

  /* One column when the container is tight — no `order` juggling needed. */
  @container (max-width: 34rem) {
    .product {
      grid-template-columns: minmax(0, 1fr);
    }
    .product--flip .product__media {
      order: 0;
    }
    .product__media :global(img) {
      max-width: 20rem;
    }
  }

  .product__media :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.6rem;
    border: 1px solid var(--sl-color-gray-5);
  }

  .product__title {
    margin: 0 0 0.9rem;
    font-size: var(--sl-text-xl);
    line-height: 1.2;
  }

  .product__title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }

  .product__title a:hover {
    color: var(--sl-color-accent-high);
  }

  .product__specs {
    margin: 0;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    /* Deliberately not `overflow: hidden` — it clipped long spec values
       instead of letting them wrap. */
  }

  .product__spec:first-child {
    border-start-start-radius: 0.5rem;
    border-start-end-radius: 0.5rem;
  }

  .product__spec:last-child {
    border-end-start-radius: 0.5rem;
    border-end-end-radius: 0.5rem;
  }

  .product__spec {
    display: grid;
    grid-template-columns: minmax(5.5rem, 9rem) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.55rem 0.85rem;
    font-size: var(--sl-text-sm);
  }

  .product__spec:nth-child(odd) {
    background: color-mix(in srgb, var(--sl-color-gray-6) 45%, transparent);
  }

  @container (max-width: 22rem) {
    .product__spec {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.15rem;
    }
  }

  .product__spec dt {
    margin: 0;
    font-weight: 600;
    color: var(--sl-color-gray-2);
  }

  .product__spec dd {
    margin: 0;
    min-width: 0;
    color: var(--sl-color-white);
    overflow-wrap: anywhere;
  }

  .product__more {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    margin-block-start: 1rem;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }

  .product__more::after {
    content: '→';
    transition: translate 140ms ease;
  }

  .product__more:hover::after {
    translate: 0.2em 0;
  }
</style>
