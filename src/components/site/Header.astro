---
/**
 * The site header — one row, and only one row.
 *
 * The previous header carried a second row of section links on desktop, on top
 * of a sidebar that already listed everything. Sections now live at the top of
 * the sidebar, which is the only persistent navigation surface on the page.
 *
 * What is left here is global: identity, search, theme, and the two community
 * links. The menu button is mobile-only and drives the same sidebar.
 */
import { Image } from 'astro:assets';
import logo from '~/assets/VoronLogo.png';
import Search from './Search.astro';
import ThemeToggle from './ThemeToggle.astro';

const SOCIAL = [
  {
    label: 'GitHub',
    href: 'https://github.com/Voron3D-wiki/voron3d-wiki',
    path: 'M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.54-3.88-1.54a3.06 3.06 0 0 0-1.28-1.69c-1.05-.71.08-.7.08-.7a2.42 2.42 0 0 1 1.77 1.19 2.46 2.46 0 0 0 3.35.96 2.46 2.46 0 0 1 .73-1.54c-2.55-.29-5.23-1.28-5.23-5.68a4.45 4.45 0 0 1 1.18-3.08 4.14 4.14 0 0 1 .12-3.04s.96-.31 3.15 1.18a10.85 10.85 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18a4.14 4.14 0 0 1 .12 3.04 4.45 4.45 0 0 1 1.18 3.08c0 4.41-2.69 5.38-5.25 5.67a2.76 2.76 0 0 1 .79 2.14v3.17c0 .31.2.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5z',
  },
  {
    label: 'Discord',
    href: 'https://discord.gg/voron',
    path: 'M20.32 4.57A19.8 19.8 0 0 0 15.43 3l-.24.49a18.3 18.3 0 0 1 4.32 1.4 15.2 15.2 0 0 0-13-.01A18.4 18.4 0 0 1 10.85 3.5L10.6 3a19.8 19.8 0 0 0-4.9 1.57C2.6 9.2 1.76 13.7 2.18 18.13a19.9 19.9 0 0 0 6.05 3.06l.73-1.28a13 13 0 0 1-2.06-1 10 10 0 0 0 .44-.34 14.2 14.2 0 0 0 11.32 0l.44.34a13 13 0 0 1-2.06 1l.73 1.28a19.9 19.9 0 0 0 6.05-3.06c.5-5.13-.85-9.6-3.5-13.56zM9.1 15.5c-1.18 0-2.15-1.08-2.15-2.4s.95-2.42 2.15-2.42 2.17 1.09 2.15 2.42c0 1.32-.96 2.4-2.15 2.4zm5.8 0c-1.18 0-2.15-1.08-2.15-2.4s.95-2.42 2.15-2.42 2.16 1.09 2.14 2.42c0 1.32-.95 2.4-2.14 2.4z',
  },
];
---

<header class="header">
  <a class="brand" href="/">
    <Image src={logo} alt="" width={28} height={28} loading="eager" />
    <span class="brand__name">Voron3D Wiki</span>
  </a>

  <div class="header__spacer"></div>

  <Search />

  <nav class="social" aria-label="Community">
    {
      SOCIAL.map((item) => (
        <a href={item.href} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={item.path} />
          </svg>
          <span class="sr-only">{item.label}</span>
        </a>
      ))
    }
  </nav>

  <ThemeToggle />

  <button class="menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="sidebar">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <path d="M4 7h16M4 12h16M4 17h16"></path>
    </svg>
    <span class="sr-only">Menu</span>
  </button>
</header>

<style>
  .header {
    position: fixed;
    inset-block-start: 0;
    inset-inline: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: var(--header-height);
    padding-inline: var(--gutter);
    border-block-end: 1px solid var(--rule);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--fg);
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }

  .brand img {
    border-radius: var(--radius-sm);
  }

  .header__spacer {
    flex: 1;
  }

  .social {
    display: flex;
    gap: var(--space-1);
  }

  .social a {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: var(--fg-faint);
    transition: color var(--ease), background-color var(--ease);
  }

  .social a:hover {
    color: var(--fg);
    background: var(--bg-hover);
  }

  .social svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .menu-button {
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius);
    color: var(--fg-muted);
  }

  .menu-button svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  @media (max-width: 64rem) {
    .menu-button {
      display: grid;
    }
    /* The community links move into the sidebar footer on small screens rather
       than competing with search and the menu button for the same row. */
    .social {
      display: none;
    }
  }

  @media (max-width: 26rem) {
    .brand__name {
      display: none;
    }
  }
</style>
