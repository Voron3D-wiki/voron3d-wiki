---
/**
 * Full-text search, over Pagefind.
 *
 * Markup and styling only — the client lives in `public/js/search.js`, which
 * explains why it has to sit outside the bundler. Loaded by BaseLayout.
 *
 * Pagefind is what Starlight used underneath, so the index quality is
 * unchanged; what is different is that this drives the JS API directly instead
 * of mounting `@pagefind/default-ui`. The default UI ships its own opinionated
 * stylesheet, which would have to be fought token by token to match the rest of
 * the site — and losing that fight is how a redesign ends up looking
 * half-finished.
 *
 * The index only exists after `pagefind` runs over `dist/`, so in `astro dev`
 * the dialog explains that rather than failing silently.
 */
---

<button class="search-trigger" type="button" data-search-open>
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
    <circle cx="11" cy="11" r="7"></circle>
    <path d="M20 20l-3.6-3.6"></path>
  </svg>
  <span class="search-trigger__label">Search</span>
  <kbd class="search-trigger__key">/</kbd>
</button>

<dialog class="search-dialog" data-search-dialog aria-label="Search the wiki">
  <form class="search-form" role="search" data-search-form>
    <svg class="search-form__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="M20 20l-3.6-3.6"></path>
    </svg>
    <input
      class="search-input"
      type="search"
      name="q"
      placeholder="Search the wiki"
      autocomplete="off"
      spellcheck="false"
      data-search-input
    />
    <button class="search-close" type="button" data-search-close>
      <kbd>Esc</kbd>
    </button>
  </form>

  <div class="search-results" data-search-results aria-live="polite"></div>
</dialog>

<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    height: 2.25rem;
    padding-inline: var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    color: var(--fg-faint);
    font-size: var(--text-sm);
    transition: border-color var(--ease), color var(--ease);
  }

  .search-trigger:hover {
    border-color: var(--rule-strong);
    color: var(--fg-muted);
  }

  .search-trigger svg {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .search-trigger__label {
    min-width: 6.5rem;
    text-align: start;
  }

  .search-trigger__key {
    padding: 0.05em 0.4em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  @media (max-width: 60rem) {
    .search-trigger__label,
    .search-trigger__key {
      display: none;
    }
    .search-trigger {
      width: 2.25rem;
      justify-content: center;
      padding-inline: 0;
      border-color: transparent;
    }
  }

  /* --- Dialog ------------------------------------------------------------ */

  .search-dialog {
    width: min(38rem, calc(100vw - 2rem));
    max-height: min(30rem, calc(100dvh - 6rem));
    margin: 0 auto;
    /* Sits high rather than centred: results grow downward, and a vertically
       centred panel jumps as they arrive. */
    margin-block-start: 12vh;
    padding: 0;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-lg);
    background: var(--bg-raised);
    color: var(--fg);
    overflow: hidden;
  }

  .search-dialog::backdrop {
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(2px);
  }

  .search-form {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--rule);
  }

  .search-form__icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: none;
    color: var(--fg-faint);
  }

  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: none;
    font-size: var(--text-lg);
    outline: none;
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
  }

  .search-close kbd {
    padding: 0.1em 0.4em;
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .search-results {
    max-height: calc(min(30rem, 100dvh - 6rem) - 3.75rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .search-results:empty {
    display: none;
  }

  .search-results :global(.search-msg) {
    padding: var(--space-5) var(--space-4);
    color: var(--fg-faint);
    font-size: var(--text-sm);
    text-align: center;
  }

  .search-results :global(.search-hit) {
    display: block;
    padding: var(--space-3) var(--space-4);
    border-block-end: 1px solid var(--rule);
    color: inherit;
    text-decoration: none;
  }

  .search-results :global(.search-hit:last-child) {
    border-block-end: none;
  }

  .search-results :global(.search-hit:hover),
  .search-results :global(.search-hit:focus-visible) {
    background: var(--bg-hover);
  }

  .search-results :global(.search-hit__title) {
    font-weight: 600;
    line-height: var(--leading-tight);
  }

  .search-results :global(.search-hit__crumb) {
    display: block;
    margin-block-start: 0.15rem;
    color: var(--fg-faint);
    font-size: var(--text-xs);
  }

  .search-results :global(.search-hit__excerpt) {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-block-start: 0.25rem;
    color: var(--fg-muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .search-results :global(.search-hit__excerpt mark) {
    background: var(--accent-soft);
    color: inherit;
    font-weight: 600;
  }
</style>
