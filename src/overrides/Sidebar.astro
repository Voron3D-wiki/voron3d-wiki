---
/**
 * Sidebar showing only the section you are in.
 *
 * Starlight's default renders every top-level group expanded — 68 links on a
 * typical page. Combined with SectionNav (which carries the top level), this
 * drops it to the current section only, roughly a screenful, without hiding
 * anything behind an extra click.
 */
import MobileMenuFooter from 'virtual:starlight/components/MobileMenuFooter';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import SectionNav from './SectionNav.astro';
import { currentSectionEntries, currentSectionLabel } from '~/lib/sidebar-sections.mjs';

const { sidebar } = Astro.locals.starlightRoute;
const entries = currentSectionEntries(sidebar);
const label = currentSectionLabel(sidebar);
---

{/* On mobile the header bar is hidden, so the switcher rides at the top of the
    menu panel instead. */}
<div class="md:sl-hidden">
  <SectionNav variant="menu" />
</div>

{label && <p class="section-heading sl-hidden md:sl-block">{label}</p>}

<SidebarPersister>
  <SidebarSublist sublist={entries} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>

<style>
  .section-heading {
    margin: 0 0 0.6rem;
    font-size: var(--sl-text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
</style>
